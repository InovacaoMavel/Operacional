# ============================================================================
#  Módulo Operacional — variáveis de ambiente.
#  Copie para .env (o .env NUNCA vai para o git) e preencha.
#     cp .env.example .env
# ============================================================================

# --- Banco (o MESMO do Hub-Locadora; este módulo só LÊ) ---------------------
# Na VPS: DB_HOST=db (serviço do stack 'frota', pela rede frota_internal).
# No seu PC: abra o túnel (RUNBOOK §6.3) e use DB_HOST=127.0.0.1 / DB_PORT=5433.
DB_HOST=db
DB_PORT=5432
DB_NAME=frota
DB_USER=frota_app
DB_PASSWORD=troque-pela-senha-real
DB_SCHEMA=locavia

# --- API --------------------------------------------------------------------
CACHE_TTL_SECONDS=180
LOG_LEVEL=INFO

# --- Microsserviços (BFF -> serviço) ----------------------------------------
# Uma variável por seção externalizada: <SECAO>_URL. Com ela preenchida, o BFF
# NÃO monta a seção no próprio processo — só faz proxy. Deixe VAZIA para rodar
# tudo num processo só (dev sem Docker). Ver api/proxy.py e RUNBOOK §4.
TELEMETRIA_URL=http://telemetria:8000
PROXY_TIMEOUT=20

# --- Reverse geocoding (lat/long -> endereço no painel lateral) -------------
# Nominatim/OpenStreetMap. A instância pública é GRATUITA, mas a política de uso
# (https://operations.osmfoundation.org/policies/nominatim/) exige:
#   - no máximo 1 requisição por segundo;
#   - User-Agent identificando a aplicação (o default de biblioteca é bloqueado);
#   - cache dos resultados do nosso lado.
# O serviço já cumpre os três. TROQUE o contato abaixo se o e-mail do time mudar
# — é por ele que a OSM avisa antes de bloquear.
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=hub-locadora-operacional/1.0 (+https://operacional.mavellocadora.com.br; inovacao@mavellocadora.com.br)
# TTL do cache de endereços: 7 dias. Endereço de uma coordenada não muda.
GEOCACHE_TTL_SECONDS=604800

# --- Login do módulo (Basic Auth no Traefik) --------------------------------
# Gere o hash:  docker run --rm httpd:2-alpine htpasswd -nbB gestor 'SenhaForte'
# Cole entre ASPAS SIMPLES e com UM só '$' (regra do stack deploy — RUNBOOK §7.2):
OPERACIONAL_AUTH='gestor:$2y$05$SUBSTITUA_PELO_HASH'
